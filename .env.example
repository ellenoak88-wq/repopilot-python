# No key: use evidence-only retrieval. Keys never go to the browser.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
# Optional separate credential for the official DeepSeek API.
DEEPSEEK_API_KEY=
GITHUB_TOKEN=
HOST=127.0.0.1
PORT=3211
REPOPILOT_PORT=3211
REPOPILOT_DATA_DIR=./data
# Optional Docker proxy, e.g. http://host.docker.internal:10808
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=

# Local embeddings: optional cache path for non-Docker runs.
# Docker always persists models under /app/data/models.
# EMBEDDING_CACHE_DIR=./data/models
HF_HUB_DISABLE_XET=1

# Import limits: 1-5000 files; 1-200 MB total UTF-8 source bytes.
REPO_MAX_FILES=1000
REPO_MAX_TOTAL_BYTES=50000000
REPO_MAX_VECTOR_WINDOWS=150000
